# Railway MySQL service reference: ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Required for signed local-login session cookies. Generate a long random value.
MANUS_JWT_SECRET=replace-with-a-long-random-secret

# Set the first administrator's login ID before registration. Existing matching
# accounts are promoted to administrator on their next login.
OWNER_LOGIN_ID=admin
# Legacy owner identifier used by the Manus-compatible upsert path, if needed.
OWNER_OPEN_ID=local:replace-after-first-registration

# Optional project/public metadata used by the existing Manus-compatible runtime.
MANUS_PROJECT_ID=stocktalk
MANUS_API_URL=
MANUS_API_KEY=

# Optional TOSS public stock-directory integration.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Optional public canonical URL for operational notes and future integrations.
APP_BASE_URL=https://your-railway-domain.up.railway.app
